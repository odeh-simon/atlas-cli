{
  "name": "@sigil/cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Sigil local-first workflow orchestration CLI",
  "bin": {
    "sigil": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sigil/adapters-claude-code": "workspace:*",
    "@sigil/adapters-codex": "workspace:*",
    "@sigil/adapters-figma": "workspace:*",
    "@sigil/adapters-github": "workspace:*",
    "@sigil/adapters-linear": "workspace:*",
    "@sigil/app-services": "workspace:*",
    "@sigil/checks": "workspace:*",
    "@sigil/diagnostics": "workspace:*",
    "@sigil/domain": "workspace:*",
    "@sigil/git": "workspace:*",
    "@sigil/llm": "workspace:*",
    "@sigil/security": "workspace:*"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  }
}
