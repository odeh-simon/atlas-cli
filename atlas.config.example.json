{
  "$schema": "./atlas.config.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "atlas-example",
    "baseBranch": "main"
  },
  "telemetry": {
    "enabled": false
  },
  "writebacks": {
    "enabled": false
  },
  "visualQa": {
    "browserChannel": "auto",
    "timeoutMs": 30000,
    "pixelThreshold": 0.1,
    "allowedDiffRatio": 0.01,
    "maxPixels": 20000000,
    "maxReferenceBytes": 10000000,
    "viewports": {
      "desktop": { "width": 1440, "height": 900 },
      "mobile": { "width": 390, "height": 844 }
    }
  },
  "checks": [
    {
      "name": "typecheck",
      "kind": "command",
      "required": true,
      "command": "pnpm",
      "args": ["check"],
      "dependsOn": ["basic-session-integrity"],
      "affected": ["packages/**", "app/**"],
      "timeoutMs": 120000
    },
    {
      "name": "design-scan",
      "kind": "design-scan",
      "required": false,
      "dependsOn": ["basic-session-integrity"],
      "root": ".",
      "maxFiles": 500
    }
  ],
  "ai": {
    "defaultProviderAlias": "openrouter.free",
    "allowCloudCodeContext": false,
    "allowCloudImages": false,
    "maxImageBytes": 5000000,
    "providers": [
      {
        "alias": "openrouter.free",
        "provider": "openai-compatible",
        "baseUrl": "https://openrouter.ai/api/v1",
        "model": "openrouter/free",
        "tokenAlias": "openrouter.default",
        "timeoutMs": 120000,
        "maxInputTokens": 12000
      }
    ]
  },
  "adapters": {
    "figma": {
      "tokenAlias": "figma.default"
    },
    "github": {
      "tokenAlias": "github.default"
    },
    "linear": {
      "tokenAlias": "linear.default"
    },
    "codex": {
      "command": "codex"
    },
    "claudeCode": {
      "command": "claude"
    }
  }
}
