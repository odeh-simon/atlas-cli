{
  "$schema": "./atlas.config.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "atlas-example",
    "baseBranch": "main"
  },
  "telemetry": {
    "enabled": false
  },
  "checks": [
    {
      "name": "typecheck",
      "kind": "command",
      "required": true,
      "command": "pnpm",
      "args": ["check"],
      "dependsOn": ["basic-session-integrity"],
      "affected": ["packages/**", "app/**"],
      "timeoutMs": 120000
    },
    {
      "name": "design-scan",
      "kind": "design-scan",
      "required": false,
      "dependsOn": ["basic-session-integrity"],
      "root": ".",
      "maxFiles": 500
    }
  ],
  "ai": {
    "defaultProviderAlias": "ollama.local",
    "providers": [
      {
        "alias": "ollama.local",
        "provider": "ollama",
        "baseUrl": "http://localhost:11434",
        "model": "qwen2.5-coder:7b",
        "timeoutMs": 10000,
        "maxInputTokens": 12000
      }
    ]
  },
  "adapters": {
    "figma": {
      "tokenAlias": "figma.default"
    },
    "github": {
      "tokenAlias": "github.default"
    },
    "linear": {
      "tokenAlias": "linear.default"
    },
    "codex": {
      "command": "codex"
    },
    "claudeCode": {
      "command": "claude"
    }
  }
}
