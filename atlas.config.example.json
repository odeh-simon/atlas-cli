{
  "$schema": "./atlas.config.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "atlas-example",
    "baseBranch": "main"
  },
  "telemetry": {
    "enabled": false
  },
  "checks": [
    {
      "name": "typecheck",
      "required": true,
      "command": "pnpm",
      "args": ["check"],
      "dependsOn": ["basic-session-integrity"],
      "timeoutMs": 120000
    }
  ],
  "adapters": {
    "figma": {
      "tokenAlias": "figma.default"
    },
    "github": {
      "tokenAlias": "github.default"
    },
    "linear": {
      "tokenAlias": "linear.default"
    },
    "codex": {
      "command": "codex"
    },
    "claudeCode": {
      "command": "claude"
    }
  }
}
