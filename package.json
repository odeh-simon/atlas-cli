{
  "name": "atlas-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Atlas local-first CLI workflow orchestrator",
  "license": "MIT",
  "author": "Simon Odeh",
  "repository": {
    "type": "git",
    "url": "https://github.com/odeh-simon/atlas-cli.git"
  },
  "bin": {
    "atlas": "./packages/cli/dist/index.js"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "atlas": "node packages/cli/dist/index.js",
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "release:bundle": "node scripts/build-release.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:check": "pnpm check && pnpm test && pnpm release:bundle && pnpm release:smoke",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
