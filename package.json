{
  "name": "sigil-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sigil local-first CLI workflow orchestrator",
  "license": "MIT",
  "author": "Simon Odeh",
  "repository": {
    "type": "git",
    "url": "https://github.com/odeh-simon/sigil.git"
  },
  "bin": {
    "sigil": "./packages/cli/dist/index.js"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sigil": "node packages/cli/dist/index.js",
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "release:bundle": "node scripts/build-release.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
