{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Project Configuration",
  "type": "object",
  "required": ["schemaVersion", "project"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": ["name", "baseBranch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseBranch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "writebacks": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visualQa": {
      "type": "object",
      "properties": {
        "browserChannel": { "type": "string", "enum": ["auto", "msedge", "chrome", "chromium"] },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "pixelThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowedDiffRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxPixels": { "type": "integer", "minimum": 1 },
        "viewports": {
          "type": "object",
          "properties": {
            "desktop": { "$ref": "#/$defs/viewport" },
            "mobile": { "$ref": "#/$defs/viewport" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "kind": { "type": "string", "enum": ["command", "design-scan"] },
          "required": { "type": "boolean" },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" } },
          "affected": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "root": { "type": "string", "minLength": 1 },
          "maxFiles": { "type": "integer", "minimum": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "defaultProviderAlias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
        "allowCloudCodeContext": { "type": "boolean" },
        "allowCloudImages": { "type": "boolean" },
        "maxImageBytes": { "type": "integer", "minimum": 1 },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alias", "provider", "baseUrl", "model"],
            "properties": {
              "alias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
              "provider": { "type": "string", "enum": ["ollama", "openai-compatible"] },
              "baseUrl": { "type": "string", "format": "uri" },
              "model": { "type": "string", "minLength": 1 },
              "tokenAlias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
              "timeoutMs": { "type": "integer", "minimum": 1 },
              "maxInputTokens": { "type": "integer", "minimum": 1 },
              "preset": { "type": "string", "enum": ["hetzner-inference"] },
              "capabilities": {
                "type": "array",
                "items": { "type": "string", "enum": ["text", "vision"] },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "properties": {
        "figma": {
          "type": "object",
          "properties": {
            "tokenAlias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
          },
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "properties": {
            "tokenAlias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
          },
          "additionalProperties": false
        },
        "linear": {
          "type": "object",
          "properties": {
            "tokenAlias": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
          },
          "additionalProperties": false
        },
        "codex": {
          "type": "object",
          "properties": {
            "command": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "claudeCode": {
          "type": "object",
          "properties": {
            "command": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 240, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 240, "maximum": 7680 }
      },
      "additionalProperties": false
    }
  }
}
